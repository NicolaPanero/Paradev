new file mode 100644
index 0000000000000000000000000000000000000000..8245e48be2cff7d79b8d4ac29da3621d051e926f
--- /dev/null
+++ b/dist/superset-context-usage.js
@@ -0,0 +1,35 @@
+import { RequestError } from "@agentclientprotocol/sdk/unstable";
+
+export const SUPERSET_CONTEXT_USAGE_METHOD = "_superset/context_usage";
+
+export function parseSupersetContextUsageRequest(value) {
+    const sessionId = value && typeof value === "object" && typeof value.sessionId === "string"
+        ? value.sessionId.trim()
+        : "";
+    if (!sessionId) {
+        throw RequestError.invalidParams(undefined, "context usage params require a non-empty sessionId");
+    }
+    return { sessionId };
+}
+
+export async function readSupersetContextUsage(query, timeoutMs = 5000) {
+    if (!query || typeof query.getContextUsage !== "function")
+        return { usage: null };
+    let timer;
+    const timeout = new Promise((resolve) => {
+        timer = setTimeout(() => resolve(null), timeoutMs);
+    });
+    try {
+        const usage = await Promise.race([
+            query.getContextUsage({ detail: "summary" }),
+            timeout,
+        ]);
+        return { usage: usage ?? null };
+    }
+    catch {
+        return { usage: null };
+    }
+    finally {
+        clearTimeout(timer);
+    }
+}
